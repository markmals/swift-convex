# The environment this project reads. Varlock loads this schema; values come from the process
# environment (CI maps secrets into the job's `env:`) or a gitignored `.env.local`. Only the
# release tasks run under `varlock run`; `mise run check` reads none of these.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# Token Knope uses to push the `release` branch, open the release pull request, and publish the
# GitHub release that tags `v<version>`. CI passes the workflow's GITHUB_TOKEN.
# @required @sensitive
GITHUB_TOKEN=
